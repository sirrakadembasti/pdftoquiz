{
  "name": "pdf-to-onlinequiz",
  "version": "2.0.10",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "node scripts/build.mjs",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node scripts/run-tests.mjs",
    "test:policy": "node scripts/check-test-policy.mjs",
    "test:acceptance": "node scripts/run-acceptance-tests.mjs",
    "test:ocr": "node scripts/ocr/run.mjs",
    "test:server": "node --import tsx --test tests/standalone-packaging.mjs tests/local-server.mjs",
    "db:migrate": "node scripts/db-command.mjs migrate",
    "user:add": "node --import tsx scripts/admin.ts",
    "user:reset": "node --import tsx scripts/admin.ts --reset",
    "backup": "node --import tsx scripts/backup.ts",
    "licenses": "node scripts/licenses.mjs",
    "reference": "node scripts/convert-reference.mjs",
    "llm": "llm-manager"
  },
  "dependencies": {
    "lucide-react": "1.52.0",
    "next": "16.4.6",
    "pdfjs-dist": "5.4.296",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "5.1.1",
    "zod": "^3.25.76",
    "@libsql/client": "0.18.0",
    "dotenv": "18.0.6",
    "tsx": "4.23.15",
    "@sirrakadembasti/llm-manager": "github:sirrakadembasti/llm-manager#ce919043071b13a739f361bbfe769fcabf023c9d"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "tailwindcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "react-test-renderer": "19.3.0",
    "@napi-rs/canvas": "0.1.100"
  }
}
