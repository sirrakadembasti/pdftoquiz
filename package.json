{
  "name": "pdf-to-onlinequiz",
  "version": "2.0.10",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "setup:bun": "bun install --frozen-lockfile && bun run db:migrate && bun scripts/admin.ts --init",
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "node scripts/build.mjs",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node scripts/run-tests.mjs",
    "test:ocr": "node sites-source/scripts/ocr/run.mjs",
    "test:server": "node --import tsx --test tests/standalone-packaging.mjs tests/local-server.mjs",
    "db:generate": "node scripts/prisma-command.mjs generate",
    "db:migrate": "node scripts/prisma-command.mjs migrate deploy",
    "user:add": "node --import tsx scripts/admin.ts",
    "user:reset": "node --import tsx scripts/admin.ts --reset",
    "backup": "node --import tsx scripts/backup.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "1.52.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "5.4.296",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "tesseract.js": "5.1.1",
    "vaul": "^1.1.2",
    "zod": "^3.25.76",
    "@prisma/client": "7.10.0",
    "@prisma/adapter-libsql": "7.10.0",
    "@libsql/client": "0.18.0",
    "dotenv": "18.0.6",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "tailwindcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.0",
    "prisma": "7.10.0",
    "react-test-renderer": "19.3.0",
    "@napi-rs/canvas": "0.1.100"
  },
  "workspaces": [
    "."
  ]
}
