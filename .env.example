# Local SQLite; the path is resolved relative to the project folder.
DATABASE_URL=file:./data/quiz.db
# Empty for localhost. Set to the exact https://quiz.example.com on a server.
APP_ORIGIN=
COOKIE_SECURE=false
# Used only by `node --import tsx scripts/admin.ts --init` (scripted first account). Normal flow: pnpm user:add.
INITIAL_ADMIN_EMAIL=admin@local.test
INITIAL_ADMIN_NAME=Öğretmen
INITIAL_ADMIN_PASSWORD=
# API keys are entered in the UI and never persisted here.
# LLM Manager (/llm paneli) yonetim girisi; parola bos ise panel AUTH_NOT_CONFIGURED hatasi verir.
LLM_ADMIN_USER=admin
LLM_ADMIN_PASSWORD=
